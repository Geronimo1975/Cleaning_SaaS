# Copiază în `.env` pe server și completează. NU se comite.
SECRET_KEY=schimba-ma-cu-50-de-caractere-aleatoare
DEBUG=0
# Aplicația trăiește pe `app.`; `www.` e site-ul WordPress (docker-compose.wp.yml).
ALLOWED_HOSTS=app.example.de

# Doar pentru varianta Traefik: gazda pe care o rutează.
APP_HOST=app.example.de

# Site-ul de marketing. Gol cât timp nu există.
MARKETING_SITE_URL=https://www.example.de

# Postgres — aceleași valori sunt citite și de serviciul `db`.
DB_NAME=cleaning
DB_USER=cleaning
DB_PASSWORD=schimba-ma
DATABASE_URL=postgres://cleaning:schimba-ma@db:5432/cleaning

# Documentele de verificare, în afara rădăcinii servite de Nginx.
PRIVATE_STORAGE_ROOT=/app/private

# Email (Brevo, Postmark, SES — orice SMTP).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.de

# Google Indexing API — cheia contului de serviciu, dacă e configurat.
GOOGLE_INDEXING_CREDENTIALS=

# Impressum (§5 TMG) și Datenschutzerklärung. Cât timp lipsesc, paginile
# afișează vizibil că nu sunt valabile. Nu se inventează.
OPERATOR_NAME=
OPERATOR_LEGAL_FORM=
OPERATOR_STREET=
OPERATOR_POSTAL_CODE=
OPERATOR_CITY=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_REPRESENTED_BY=
OPERATOR_REGISTER_COURT=
OPERATOR_REGISTER_NUMBER=
OPERATOR_VAT_ID=
OPERATOR_SUPERVISORY_AUTHORITY=
OPERATOR_DPO_EMAIL=

# WordPress (docker-compose.wp.yml). Stack separat, aceeași rețea Traefik.
WP_HOST=www.example.de
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=schimba-ma
